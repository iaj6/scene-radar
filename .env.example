# Either export ANTHROPIC_API_KEY, or run `ant auth login` and leave this unset —
# the SDK picks up the OAuth profile automatically with a bare `new Anthropic()`.
#
# Careful: a set (even empty) ANTHROPIC_API_KEY silently shadows an `ant` profile.
ANTHROPIC_API_KEY=

# Later, if a digest agent gets added and emails you the weekly roundup:
# RESEND_API_KEY=
