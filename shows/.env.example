# Vercel Blob store — the database behind bands, shows, sources and sweeps.
# Auto-injected on Vercel once a Blob store is attached; set by hand for local dev
# (`vercel env pull`).
BLOB_READ_WRITE_TOKEN=

# Bearer the radar agent presents on /api/mcp. Generate with:
#   openssl rand -hex 32
# Store the SAME value as a static_bearer vault credential via `npm run setup-mcp` in
# the parent project — the agent never sees it; Anthropic injects it at egress.
MCP_TOKEN=

# Bearer the sweep runner presents to archive a finished report (POST /api/sweeps).
# Separate from MCP_TOKEN on purpose: a leaked ingest token can write history but
# cannot read or curate the board. Export it in the parent project when running sweeps.
INGEST_TOKEN=

# HTTP Basic Auth password for the UI (username ignored).
# Unset = open on localhost only; on Vercel an unset value locks the board with a 503.
BOARD_PASSWORD=

# Publish the board as an anonymous, read-only view. Unset or anything other than "1"
# keeps it fully locked behind BOARD_PASSWORD (the default).
#
# When "1": GET/HEAD from an unauthenticated visitor is served with `status` and
# `notes` stripped server-side — your triage decisions and private notes never reach
# the page. Every write stays behind Basic Auth, and the agent/ingest bearers are
# unaffected. You still get the full board and all editing by logging in.
PUBLIC_VIEW=
